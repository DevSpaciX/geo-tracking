# Copy to .env and adjust. All values have defaults in docker-compose.yml / app/config.py.
APP_PORT=8080
DB_PORT=5433
POSTGRES_PASSWORD=geo
LOG_LEVEL=INFO
WEB_CONCURRENCY=1

# Ingestion tuning
INGEST_BATCH_SIZE=2000
INGEST_FLUSH_INTERVAL_MS=200
STORE_LOCATION_HISTORY=true
ALERT_REPEAT_INSIDE=true

# Load generator (docker compose --profile load up generator)
GEN_DEVICES=10000
GEN_INTERVAL=3
GEN_CONNECTIONS=20
GEN_BATCH=250
